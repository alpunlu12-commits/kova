{
  "name": "kova",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "PATH=\"/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$PATH\" tauri",
    "app": "npm run tauri dev",
    "app:build": "npm run tauri build -- --config scripts/tauri.local.conf.json",
    "tauri:win": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 PATH=\"/opt/homebrew/opt/llvm/bin:/opt/homebrew/opt/lld/bin:/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$PATH\" tauri",
    "app:build:win": "npm run tauri:win build -- --config scripts/tauri.local.conf.json --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis",
    "release": "node scripts/release.mjs",
    "release:test": "node scripts/release-test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-dialog": "^2.8.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
